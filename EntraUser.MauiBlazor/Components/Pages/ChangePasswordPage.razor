@page "/change-password"
@namespace EntraUser.MauiBlazor.Components.Pages

<RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center"
             Style="min-height:100vh;padding:2rem;background:var(--rz-base-background-color)">
    <RadzenCard Style="width:100%;max-width:420px">
        <RadzenStack Gap="1.25rem">

            <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenIcon Icon="lock_reset"
                            Style="font-size:2.5rem;color:#BA7517" />
                <RadzenText TextStyle="TextStyle.H6"
                            Style="font-weight:500;margin:0">
                    Change your password
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Body2"
                            Style="color:var(--rz-text-secondary-color);text-align:center">
                    Your administrator requires you to set a new
                    password before continuing.
                </RadzenText>
            </RadzenStack>

            <RadzenFormField Text="New password" Style="width:100%">
                <RadzenPassword @bind-Value="_newPassword"
                                @bind-Value:after="Validate"
                                Placeholder="Min 8 characters"
                                InputAttributes="@(new Dictionary<string,object>
                                    {{ "autocomplete","new-password" }})" />
            </RadzenFormField>

            <RadzenFormField Text="Confirm new password" Style="width:100%">
                <RadzenPassword @bind-Value="_confirmPassword"
                                @bind-Value:after="Validate"
                                Placeholder="Repeat password"
                                InputAttributes="@(new Dictionary<string,object>
                                    {{ "autocomplete","new-password" }})" />
            </RadzenFormField>

            <RadzenStack Gap="0.2rem">
                <ValidationItem Ok="@(_newPassword.Length >= 8)"
                                Text="At least 8 characters" />
                <ValidationItem Ok="@HasUppercase" Text="Contains uppercase letter" />
                <ValidationItem Ok="@HasLowercase" Text="Contains lowercase letter" />
                <ValidationItem Ok="@HasDigit"     Text="Contains a number" />
                <ValidationItem Ok="@HasSpecial"   Text="Contains special character" />
                <ValidationItem Ok="@PasswordsMatch" Text="Passwords match" />
            </RadzenStack>

            @if (_error is not null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger"
                             ShowIcon="true" Variant="Variant.Flat">@_error</RadzenAlert>
            }
            @if (_success is not null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Success"
                             ShowIcon="true" Variant="Variant.Flat">@_success</RadzenAlert>
            }

            <RadzenButton Text="Update password"
                          Icon="lock"
                          ButtonStyle="ButtonStyle.Success"
                          Style="width:100%"
                          Click="@HandleChangePassword"
                          IsBusy="@_busy"
                          Disabled="@(!IsFormValid)" />

        </RadzenStack>
    </RadzenCard>
</RadzenStack>

@code {
    [Inject] IMediator           Mediator { get; set; } = default!;
    [Inject] NavigationManager   Nav      { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "objectId")] public string? ObjectId { get; set; }
    [SupplyParameterFromQuery(Name = "upn")]      public string? Upn      { get; set; }

    string  _newPassword     = "";
    string  _confirmPassword = "";
    bool    _busy;
    string? _error;
    string? _success;

    bool HasUppercase   => _newPassword.Any(char.IsUpper);
    bool HasLowercase   => _newPassword.Any(char.IsLower);
    bool HasDigit       => _newPassword.Any(char.IsDigit);
    bool HasSpecial     => _newPassword.Any(c => !char.IsLetterOrDigit(c));
    bool PasswordsMatch => _newPassword == _confirmPassword &&
                           !string.IsNullOrEmpty(_confirmPassword);
    bool IsFormValid    => _newPassword.Length >= 8 && HasUppercase &&
                           HasLowercase && HasDigit && HasSpecial && PasswordsMatch;

    void Validate() => StateHasChanged();

    async Task HandleChangePassword()
    {
        _busy    = true;
        _error   = null;
        _success = null;
        try
        {
            var result = await Mediator.Send(new ChangePasswordCommand(
                ObjectId ?? "", Upn ?? "", _newPassword, _confirmPassword));

            if (!result.Success) { _error = result.Message; return; }

            _success = result.Message;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(1500);

            Nav.NavigateTo($"/set-pin?upn={Uri.EscapeDataString(Upn ?? "")}");
        }
        catch (Exception ex) { _error = $"Failed: {ex.Message}"; }
        finally { _busy = false; await InvokeAsync(StateHasChanged); }
    }
}
